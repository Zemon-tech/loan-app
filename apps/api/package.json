{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Customer loan tracker API — Express + TypeScript, read-only MySQL access, OTP/JWT auth.",
  "main": "src/server.ts",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:latest": "tsx --env-file-if-exists=.env src/db/migrate.ts latest",
    "migrate:rollback": "tsx --env-file-if-exists=.env src/db/migrate.ts rollback",
    "migrate:status": "tsx --env-file-if-exists=.env src/db/migrate.ts status",
    "migrate:make": "tsx --env-file-if-exists=.env src/db/migrate.ts make"
  },
  "dependencies": {
    "@app/shared": "*",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "mysql2": "^3.24.5",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.1.0",
    "typescript": "~5.6.0",
    "vitest": "^2.1.0"
  }
}
