# API environment (validated at boot via zod). NEVER commit real values. PRD 19.3
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Client DB (READ-ONLY user)
CLIENT_DB_HOST=localhost
CLIENT_DB_PORT=3306
CLIENT_DB_USER=app_ro
CLIENT_DB_PASSWORD=
CLIENT_DB_NAME=client_db

# App-owned schema (READ/WRITE)
APP_DB_HOST=localhost
APP_DB_PORT=3306
APP_DB_USER=app_rw
APP_DB_PASSWORD=
APP_DB_NAME=mobile_app

# Auth
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30
OTP_HMAC_SECRET=
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=3
OTP_DEV_MODE=false

# SMS
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# App config / store
MIN_APP_VERSION_ANDROID=1.0.0
MIN_APP_VERSION_IOS=1.0.0
STORE_URL_ANDROID=
STORE_URL_IOS=
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=

# Lender / support / grievance (shown in /config)
LENDER_LEGAL_NAME=
LENDER_RBI_REG_NO=
LENDER_ADDRESS=
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
SUPPORT_HOURS=
GRIEVANCE_NAME=
GRIEVANCE_PHONE=
GRIEVANCE_EMAIL=
PRIVACY_POLICY_URL=
TERMS_URL=

# Monitoring
SENTRY_DSN=
