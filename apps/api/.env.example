# API environment (validated at boot via zod). NEVER commit real values. PRD 19.3
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Loan data source: mock (demo) | client_api (live) | mysql (only if direct DB access)
DATA_SOURCE=mock
# DEMO ONLY: pin "today" to a fixed IST date (YYYY-MM-DD) so the fixture scenario renders
# deterministically. Leave unset in staging/production to use the real date.
DEMO_AS_OF_DATE=2026-09-19

# Client DB (READ-ONLY user)
CLIENT_DB_HOST=localhost
CLIENT_DB_PORT=3306
CLIENT_DB_USER=app_ro
CLIENT_DB_PASSWORD=
CLIENT_DB_NAME=client_db

# App-owned schema (READ/WRITE — DML only, used by the running server)
APP_DB_HOST=localhost
APP_DB_PORT=3306
APP_DB_USER=app_rw
APP_DB_PASSWORD=
APP_DB_NAME=mobile_app

# Migrator credential (DDL on mobile_app) — used ONLY by `npm run migrate:*`, never the server.
# Falls back to APP_DB_USER/PASSWORD if unset.
APP_DB_MIGRATOR_USER=app_migrator
APP_DB_MIGRATOR_PASSWORD=

# Auth
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30
OTP_HMAC_SECRET=
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=3
OTP_DEV_MODE=false

# SMS
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# App config / store
MIN_APP_VERSION_ANDROID=1.0.0
MIN_APP_VERSION_IOS=1.0.0
STORE_URL_ANDROID=
STORE_URL_IOS=
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=

# Lender / support / grievance (shown in /config)
LENDER_LEGAL_NAME=
LENDER_RBI_REG_NO=
LENDER_ADDRESS=
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
SUPPORT_HOURS=
GRIEVANCE_NAME=
GRIEVANCE_PHONE=
GRIEVANCE_EMAIL=
PRIVACY_POLICY_URL=
TERMS_URL=

# Monitoring
SENTRY_DSN=
