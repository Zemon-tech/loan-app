# Mobile config (EXPO_PUBLIC_* values are PUBLIC by definition — no secrets here). PRD 19.2
EXPO_PUBLIC_API_MODE=mock
# ORIGIN ONLY — no path segment. Request paths carry the full /api/v1 prefix. In live mode a
# path-carrying or non-https base URL THROWS at startup (e.g. the old .../v1 default would).
EXPO_PUBLIC_API_BASE_URL=https://online.alangcredits.com
# Play Integrity (client-only WARN; backend verification pending — see docs/DECISIONS.md D-INTEGRITY).
# Default off; a missing cloudProjectNumber never breaks the app.
EXPO_PUBLIC_INTEGRITY_ENABLED=false
# Google Cloud project number for @expo/app-integrity. NOT a secret, but still unknown — fill in
# when provided by the lender. Leave blank to keep integrity disabled.
# EXPO_PUBLIC_INTEGRITY_CLOUD_PROJECT_NUMBER=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ENV=development
# Prototype only: preview blocking screens. one of: ok | maintenance | update
EXPO_PUBLIC_MOCK_BOOT=ok
# Prototype only: Home loan scenario. one of: multi | one | active_closed | all_closed | none | new_loan
EXPO_PUBLIC_MOCK_LOANS=multi
# Prototype only: request states. one of: ok | loading | error | offline | session_expired
EXPO_PUBLIC_MOCK_NETWORK=ok
# Prototype only: simulated latency in ms (0 = instant)
EXPO_PUBLIC_MOCK_DELAY_MS=900
