# Mobile config (EXPO_PUBLIC_* values are PUBLIC by definition — no secrets here). PRD 19.2
EXPO_PUBLIC_API_MODE=mock
EXPO_PUBLIC_API_BASE_URL=https://api.example.com/v1
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ENV=development
# Prototype only: preview blocking screens. one of: ok | maintenance | update
EXPO_PUBLIC_MOCK_BOOT=ok
# Prototype only: Home loan scenario. one of: multi | one | active_closed | all_closed | none | new_loan
EXPO_PUBLIC_MOCK_LOANS=multi
# Prototype only: request states. one of: ok | loading | error | offline | session_expired
EXPO_PUBLIC_MOCK_NETWORK=ok
# Prototype only: simulated latency in ms (0 = instant)
EXPO_PUBLIC_MOCK_DELAY_MS=900
